# ============================================================
# CEYA Arquitectura — variables de entorno (plantilla)
# ============================================================
# Copia este archivo a .env y completa los valores en local.
# NUNCA versiones .env ni secretos reales.
# En producción los valores se inyectan desde el gestor de secretos del contenedor.
# ============================================================

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Backend (Fastify) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# --- Base de datos (PostgreSQL, red interna) ---
DATABASE_URL=

# --- Autenticación ---
AUTH_SECRET=

# --- Correo (SMTP / IMAP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
MAIL_FROM=

# --- IA / OpenClaw (backend intermediario) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=

# --- Observabilidad (opcional) ---
SENTRY_DSN=
